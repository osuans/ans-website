---
import Navigation from "./Navigation.astro";
---

<header class="sticky top-0 z-50 w-full bg-secondary-50 backdrop-blur-md shadow-sm">
  <div class="container flex items-center justify-between h-20">
    <a href="/" class="text-2xl font-bold text-primary-800 font-serif flex items-center">
      <span class="sr-only">ANS at OSU</span>
      <img
        src="/uploads/ANS-badge-red.webp"
        alt="ANS at OSU logo"
        width="256"
        height="256"
        decoding="async"
        class="h-[4.5rem] w-auto mr-2"
      />
      <span class="text-primary-800">American Nuclear Society at OSU</span>
    </a>
    
    <Navigation />
  </div>
</header>