---
import Button from "../UI/Button.astro";
import { heroImage } from "../../lib/heroImage";

export interface Props {
  title?: string;
  subtitle?: string;
  ctaText?: string;
  ctaLink?: string;
  secondaryCtaText?: string;
  secondaryCtaLink?: string;
}

const {
  title = "The American Nuclear Society at OSU",
  subtitle = "Empowering the next generation of nuclear professionals",
    ctaText="Join Us",
    ctaLink="/join",
    secondaryCtaText="Events",
    secondaryCtaLink="/events",
} = Astro.props;
---

<section class="relative min-h-[70vh] flex items-center pt-30 overflow-hidden">
  <img
    src={heroImage.src}
    srcset={heroImage.srcSet}
    sizes={heroImage.sizes}
    alt=""
    aria-hidden="true"
    width={heroImage.width}
    height={heroImage.height}
    fetchpriority="high"
    decoding="async"
    class="absolute inset-0 -z-20 w-full h-full object-cover"
    style="object-position: center 20%;"
  />
  <div class="absolute inset-0 -z-10 bg-black/60"></div>

  <div class="container">
    <div class="max-w-3xl text-white">
      <h1 class="text-4xl md:text-6xl font-bold mb-4 text-white">{title}</h1>
      <p class="text-xl md:text-2xl mb-8">{subtitle}</p>
      
      <div class="flex flex-wrap gap-4">
        <Button href={ctaLink} variant="primary">
          {ctaText}
        </Button>
        
        <Button href={secondaryCtaLink} variant="outline" class="bg-white/10 text-white border-white hover:bg-white hover:text-gray-900 backdrop-blur-sm">
          {secondaryCtaText}
        </Button>
      </div>
    </div>
  </div>
</section>