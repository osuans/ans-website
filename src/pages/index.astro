---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/Sections/HeroSection.astro";
import EventList from "../components/Sections/EventList.astro";
import CalendarEvents from "../components/Sections/CalendarEvents.astro";
import Button from "../components/UI/Button.astro";
import { sanityClient } from "../lib/sanity";
import { fetchCalendarEvents, type CalendarEvent } from "../utils/icsParser";
import { CONFIG } from "../constants";
import { heroImage } from "../lib/heroImage";

interface SanityEvent {
  title: string;
  slug: string;
  date: string;
  time?: string;
  location: string;
  summary: string;
  featured?: boolean;
  imageUrl?: string;
}

const today = new Date();
today.setHours(0, 0, 0, 0);

// Kick both requests off together. CalendarEvents can fetch its own data, but
// doing so renders it after the Sanity query resolves, so the two round trips
// stack up in front of the first byte instead of overlapping.
const [upcomingEvents, calendarEvents] = await Promise.all([
  sanityClient
    .fetch<SanityEvent[]>(
      `*[_type == "event" && draft != true && date >= $today] | order(date asc) {
      title, "slug": slug.current, date, time, location, summary, featured,
      "imageUrl": image.asset->url
    }`,
      { today: today.toISOString() }
    )
    .catch((error) => {
      console.error("Failed to fetch upcoming events:", error);
      return [] as SanityEvent[];
    }),
  fetchCalendarEvents(CONFIG.CALENDAR.FETCH_URL, {
    limit: 3,
    futureOnly: true,
  }).catch((error) => {
    console.error("Failed to load calendar events:", error);
    return [] as CalendarEvent[];
  }),
]);
---

<BaseLayout
  preloadImage={heroImage}
>
  <HeroSection
    title="American Nuclear Society at Ohio State"
    subtitle="Advancing nuclear science education, research, and professional development"
    ctaText="Become a Member"
    ctaLink="/contact-us"
    secondaryCtaText="Upcoming Events"
    secondaryCtaLink="/events"
  />

  <!-- About Section -->
  <section class="py-16 bg-secondary-100">
    <div class="container">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div>
          <img
            src="/uploads/scottlab.webp"
            alt="Nuclear engineering students at Ohio State University Scott Laboratory"
            width="1024"
            height="796"
            loading="lazy"
            decoding="async"
            class="rounded-lg shadow-lg object-cover w-full h-full"
          />
        </div>

        <div>
          <h2 class="text-3xl md:text-4xl font-bold mb-6">Who We Are</h2>
          <p class="text-gray-700 mb-8 text-lg">
            The ANS Student Section aims to promote and raise awareness about
            Nuclear Science and Technology by sharing resources, networking,
            and engagement through professional &amp; social activities among
            the students in the College of Engineering and other relevant
            faculties.
          </p>

          <Button href="/about-us"> Learn More About Us </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Events Section -->
  <EventList events={upcomingEvents} />

  <!-- Calendar Events from Outlook -->
  <CalendarEvents events={calendarEvents} />

  <!-- Call to Action -->
  <section
    class="py-20 bg-cover bg-center text-white"
    style="background-image: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), url(/uploads/npp2.webp)"
  >
    <div class="container ">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-6 text-white">
          Shape the Future of Clean Energy
        </h2>
        <p class="text-xl mb-8">
          Join a community of scholars and professionals advancing nuclear
          science and technology. Access research opportunities, industry
          connections, and leadership development.
        </p>

        <div class="flex flex-wrap justify-center gap-4">
          <Button href="/contact-us" variant="primary" size="lg">
            Become a Member
          </Button>

          <Button
            href="/events"
            variant="outline"
            size="lg"
            class="bg-white/10 text-white border-white hover:bg-white hover:text-gray-900 backdrop-blur-sm"
          >
           View Events
          </Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
