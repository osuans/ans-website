---
import "../assets/styles/global.css";
import Seo from "../components/UI/Seo.astro";
import Header from "../components/Global/Header.astro";
import Footer from "../components/Global/Footer.astro";
import bodyFont from "../assets/fonts/source-sans-pro-latin-400.woff2?url";
import headingFont from "../assets/fonts/playfair-display-latin-700.woff2?url";

export interface Props {
  title?: string;
  description?: string;
  image?: {
    url: string;
    alt: string;
  };
  type?: "website" | "article";
  canonicalUrl?: string;
  /**
   * LCP image to preload, so it starts downloading with the HTML instead of
   * after the browser has parsed its way down to the `<img>`.
   */
  preloadImage?: {
    src: string;
    srcSet?: string;
    sizes?: string;
  };
}

const {
  title = "ANS at OSU | American Nuclear Society at Ohio State University",
  description = "The American Nuclear Society (ANS) student chapter at The Ohio State University. Join our community of nuclear engineering students for professional development, research opportunities, and industry connections.",
  image = {
    url: "/uploads/ANS-badge-red.png",
    alt: "American Nuclear Society at Ohio State University - ANS OSU Logo",
  },
  type = "website",
  canonicalUrl,
  preloadImage,
} = Astro.props;

/**
 * Serve these pages from Vercel's edge cache.
 *
 * Every render performs server-side fetches (Sanity, and the Outlook calendar
 * feed on the homepage), which put roughly a second of network latency in front
 * of the first byte. The content is identical for all visitors, so the CDN can
 * absorb that: `s-maxage` gives a warm cache for five minutes and
 * `stale-while-revalidate` keeps serving instantly for a day while a refresh
 * happens in the background. `max-age=0` keeps browsers revalidating, so an
 * editor's Sanity change still shows up on reload.
 */
Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=0, s-maxage=300, stale-while-revalidate=86400"
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />

    {/* Fonts are self-hosted (see global.css). Preloading the two faces used
        above the fold starts them alongside the stylesheet rather than after
        it, so text settles in its final face before first paint. */}
    <link rel="preload" as="font" type="font/woff2" href={bodyFont} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={headingFont} crossorigin />

    {preloadImage && (
      <link
        rel="preload"
        as="image"
        href={preloadImage.src}
        imagesrcset={preloadImage.srcSet}
        imagesizes={preloadImage.sizes}
        fetchpriority="high"
      />
    )}

    <Seo
      title={title}
      description={description}
      image={image}
      type={type}
      canonicalUrl={canonicalUrl}
    />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="manifest" href="/site.webmanifest">
  </head>
  <body>
    <div class="flex flex-col min-h-screen">
      <Header />
      
      <main class="flex-grow">
        <slot />
      </main>
      
      <Footer />
    </div>
  </body>
</html>